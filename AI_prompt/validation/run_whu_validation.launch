<launch>
    <arg name="data_folder" />
    <arg name="points_folder" />
    <arg name="shift_x" />
    <arg name="shift_y" />
    <arg name="shift_z" />
    <arg name="rviz" default="false" />

    <rosparam command="load" file="$(find fast_lio)/config/marsim.yaml" />
    <rosparam command="load" file="$(find fast_lio)/config/generate_block.yaml" />

    <param name="feature_extract_enable" type="bool" value="false" />
    <param name="point_filter_num" type="int" value="3" />
    <param name="max_iteration" type="int" value="10" />
    <param name="filter_size_surf" type="double" value="0.2" />
    <param name="filter_size_map" type="double" value="0.2" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="false" />

    <param name="ref_map/mode" type="string" value="no_ref" />
    <param name="pcd_save/pcd_save_en" type="bool" value="false" />
    <param name="frame_number" type="int" value="80" />
    <!-- Existing WHU submaps were built from filtered body-frame clouds. -->
    <param name="save_registered_data" type="bool" value="false" />
    <param name="apply_global_shift" type="bool" value="true" />
    <rosparam param="global_shift" subst_value="true">
        [1.0, 0.0, 0.0, $(arg shift_x),
         0.0, 1.0, 0.0, $(arg shift_y),
         0.0, 0.0, 1.0, $(arg shift_z),
         0.0, 0.0, 0.0, 1.0]
    </rosparam>

    <param name="dataFolder" type="string" value="$(arg data_folder)" />
    <param name="pointsFolder" type="string" value="$(arg points_folder)" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />
    <node pkg="fast_lio" type="generate_block" name="generate_block" output="screen" />

    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
              args="-d $(find fast_lio)/rviz_cfg/helmet_livox.rviz" />
    </group>
</launch>
